# SPDX-License-Identifier: CC0-1.0
#
# BlocksDS Makefile for the REAL game (OptiCraftDsi.nds), as opposed to
# Makefile's DsiBringup.nds hardware smoke test. Separate on purpose: this
# target pulls in the entire shared src/client + src/net/minecraft/src +
# src/java + src/util + src/platform tree (the same set cmake/
# SourceSelection.cmake's mcbeta_collect_common_sources() gives PC/PS2/Wii),
# which is orders of magnitude bigger and far less proven than the bring-up
# smoke test. If this target's source list or flags turn out to need
# iterating, DsiBringup.nds -- already confirmed working on real hardware --
# must not be put at risk; hence its own Makefile, untouched here.
#
#   cd src/dsi && make -f Makefile.game
#
# Produces OptiCraftDsi.nds.

export BLOCKSDS			?= /opt/blocksds/core
export BLOCKSDSEXT		?= /opt/blocksds/external

export WONDERFUL_TOOLCHAIN	?= /opt/wonderful
ARM_NONE_EABI_PATH	?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/

NAME		:= OptiCraftDsi

# The shared engine tree (same set as cmake/SourceSelection.cmake's
# mcbeta_collect_common_sources(), minus src/external which is added below
# separately since it sits next to, not under, these), plus this platform's
# own system/ (early init) and lwjgl/ (Display_dsi.cpp) trees. NOT "tools" or
# "probe": those hold DsiBringup.cpp's and ThreadProbe.cpp's own main(),
# which would collide with main_dsi.cpp's below.
# NOT "compat": that shadow-header directory is deliberately excluded from
# the recursive .cpp search below (it holds no .cpp files anyway) and only
# feeds INCLUDEDIRS, so #include <mutex>/<thread>/<condition_variable>
# resolve to it instead of the real toolchain's versions. See
# src/dsi/compat/mutex for why.
SOURCEDIRS	:= ../client ../java ../net ../util ../platform ../external system lwjgl
# "compat" first: for #include <...>, -I directories are searched in the
# order given, before the compiler's own built-in system headers either way,
# but listing it first here keeps that precedence obvious at a glance.
#
# ../../external/zlib and ../../external/stb are git submodules at the repo
# root (see ../../.gitmodules), the same ones the PC CMake target links
# against (zlibstatic) and includes (stb) -- RegionFile.cpp/
# CompressedStreamTools.cpp/etc need <zlib.h> for chunk/NBT compression (the
# same "chunk streaming to SD" feature this whole port started from), and
# src/external/stb_image.cpp needs stb_image.h. Neither has a DSi-specific
# replacement: it is the same zlib deflate/inflate code every platform uses.
INCLUDEDIRS	:= compat .. ../../external/zlib ../../external/stb build/$(NAME)/zconf

DEFINES		:= -DDSI_PLATFORM=1

# No custom ARM7 code and no DSWiFi/audio yet, so the prebuilt "libnds only"
# core is enough. Swap to arm7_dswifi_maxmod.elf once networking/audio land.
ARM7ELF		:= $(BLOCKSDS)/sys/arm7/main_core/arm7_minimal.elf

LIBS		:= -lnds9
LIBDIRS		:= $(BLOCKSDS)/libs/libnds

BUILDDIR	:= build/$(NAME)
ELF		:= build/$(NAME).elf
DUMP		:= build/$(NAME).dump
MAP		:= build/$(NAME).map
ROM		:= $(NAME).nds

# zlib's own CMakeLists.txt generates zconf.h from zconf.h.cmakein via CMake's
# configure_file() into the (CMake) build directory, never the source tree --
# there is no configure script to run for a plain Makefile build instead.
# zconf.h.cmakein has exactly two #cmakedefine lines (grep confirms no other
# @VAR@/#cmakedefine platform probing): Z_PREFIX (off -- the "standard"
# unprefixed zlib, which is what every #include <zlib.h> call site here
# expects) and Z_HAVE_UNISTD_H (on -- BlocksDS/newlib provides <unistd.h>,
# already relied on by PosixFileSystem.cpp). `#cmakedefine FOO` becomes
# `#define FOO` when set or a comment when not, same as CMake's own
# configure_file() would produce for these two values. Generated into our
# own build/ dir, same as CMake would, rather than the submodule's checked-
# out source tree.
$(shell $(MKDIR) -p $(BUILDDIR)/zconf && sed \
	-e 's/#cmakedefine Z_PREFIX/\/* #undef Z_PREFIX *\//' \
	-e 's/#cmakedefine Z_HAVE_UNISTD_H/#define Z_HAVE_UNISTD_H/' \
	../../external/zlib/zconf.h.cmakein > $(BUILDDIR)/zconf/zconf.h)

PREFIX		:= $(ARM_NONE_EABI_PATH)arm-none-eabi-
CC		:= $(PREFIX)gcc
CXX		:= $(PREFIX)g++
LD		:= $(PREFIX)gcc
OBJDUMP		:= $(PREFIX)objdump
MKDIR		:= mkdir
RM		:= rm -rf

ifeq ($(VERBOSE),1)
V		:=
else
V		:= @
endif

SOURCES_S	:= $(shell find -L $(SOURCEDIRS) -name "*.s")
SOURCES_C	:= $(shell find -L $(SOURCEDIRS) -name "*.c")

# zlib itself (see the zconf.h comment above) -- the same source list as
# external/zlib/CMakeLists.txt's ZLIB_SRCS, minus the Windows resource files.
SOURCES_C	+= ../../external/zlib/adler32.c \
		   ../../external/zlib/compress.c \
		   ../../external/zlib/crc32.c \
		   ../../external/zlib/deflate.c \
		   ../../external/zlib/gzclose.c \
		   ../../external/zlib/gzlib.c \
		   ../../external/zlib/gzread.c \
		   ../../external/zlib/gzwrite.c \
		   ../../external/zlib/inflate.c \
		   ../../external/zlib/infback.c \
		   ../../external/zlib/inftrees.c \
		   ../../external/zlib/inffast.c \
		   ../../external/zlib/trees.c \
		   ../../external/zlib/uncompr.c \
		   ../../external/zlib/zutil.c

# The full common tree pulls in every platform's own backend file for each
# family (RenderAPI_PC.cpp, RenderAPI_GX_WII.cpp, ...) since they all live
# under src/platform alongside the DSi ones -- cmake/SourceSelection.cmake
# excludes the other platforms' by regex per family for the same reason
# (mcbeta_select_backend); this replicates that exclusion in make/grep terms.
# The remote-stats exclusion mirrors mcbeta_exclude_remote_stats_sources():
# console-local stats never instantiate the desktop synchronizer, so its
# thread/JSON/MD5 implementation is excluded rather than compiled unreachable.
_ALL_CPP	:= $(shell find -L $(SOURCEDIRS) -name "*.cpp")
SOURCES_CPP	:= $(shell echo "$(_ALL_CPP)" | tr ' ' '\n' \
		     | grep -Ev '/(RenderAPI|RenderTerrainAPI)_(PC|GL|GX_WII|GS_PS2)\.cpp$$' \
		     | grep -Ev '/(SoundManager)_(PC|WII|PS2)\.cpp$$' \
		     | grep -Ev '/(StorageBackend|InputBackend|LegacyControlPromptBackend|Resources|Diagnostics|GameSettingsBackend|PlatformUserSettings|Profiler|ClientProfilerBackend|ClientPlatformPolicy|ScreenshotBackend|RenderLightingProfile|TextureResidencyPolicy)_(PC|WII|PS2)\.cpp$$' \
		     | grep -Ev '/(StatsSyncher|ThreadStatSyncherReceive|ThreadStatSyncherSend|MD5String|J_[A-Za-z0-9_]*)\.cpp$$')

# main_dsi.cpp sits directly in src/dsi/ ("." relative to this Makefile,
# i.e. not under any of SOURCEDIRS above, which deliberately excludes "."
# so it does not also sweep up tools/ and probe/ next to it).
SOURCES_CPP	+= main_dsi.cpp

# NO_NETWORK: no DSWiFi wired up yet (see the ARM7ELF comment above), and it
# is what already flips the existing PLATFORM_LOCAL_RESOURCES_ONLY knob (see
# PlatformConfig.h) so ThreadDownloadResources scans resources synchronously
# instead of spinning up a std::thread this toolchain cannot actually run.
DEFINES		+= -D__NDS__ -D__BLOCKSDS__ -DARM9 -DNO_SOUND -DNO_NETWORK

ARCH		:= -mthumb -mcpu=arm946e-s+nofp

# See Makefile's own comment on this -- same reasoning, same file.
SPECS		:= $(BLOCKSDS)/sys/crts/dsi_arm9.specs

WARNFLAGS	:= -Wall

ifeq ($(SOURCES_CPP),)
	LIBS	+= -lc
else
	LIBS	+= -lstdc++ -lc
endif

INCLUDEFLAGS	:= $(foreach path,$(INCLUDEDIRS),-I$(path)) \
		   $(foreach path,$(LIBDIRS),-I$(path)/include)

LIBDIRSFLAGS	:= $(foreach path,$(LIBDIRS),-L$(path)/lib)

ASFLAGS		+= -x assembler-with-cpp $(INCLUDEFLAGS) $(DEFINES) \
		   $(ARCH) -ffunction-sections -fdata-sections \
		   -specs=$(SPECS)

CFLAGS		+= $(WARNFLAGS) $(INCLUDEFLAGS) $(DEFINES) \
		   $(ARCH) -O2 -ffunction-sections -fdata-sections \
		   -specs=$(SPECS)

# No -fno-exceptions/-fno-rtti: unlike libnds's own build, the shared engine
# code (Minecraft.cpp and friends) uses real try/catch and dynamic_cast
# throughout, the same as it does on PS2 and Wii (neither of which disables
# them either -- see cmake/ps2.cmake, cmake/wii.cmake). See the DsiBringup
# Makefile's own history for why this was tried and reverted.
CXXFLAGS	+= $(WARNFLAGS) $(INCLUDEFLAGS) $(DEFINES) \
		   $(ARCH) -O2 -ffunction-sections -fdata-sections \
		   -std=gnu++17 \
		   -specs=$(SPECS)

LDFLAGS		+= $(ARCH) $(LIBDIRSFLAGS) -Wl,-Map,$(MAP) $(DEFINES) \
		   -Wl,--start-group $(LIBS) -Wl,--end-group -specs=$(SPECS)

OBJS_SOURCES	:= $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_S))) \
		   $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_C))) \
		   $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_CPP)))

OBJS		:= $(OBJS_SOURCES)

DEPS		:= $(OBJS:.o=.d)

.PHONY: all clean dump sources

all: $(ROM)

# Prints the resolved source list without building anything -- useful in CI
# to sanity-check the find/grep source selection before spending build time.
sources:
	@echo "$(SOURCES_CPP)" | tr ' ' '\n'

# No -b/icon/title-banner yet -- see Makefile's own note on this.
$(ROM): $(ELF)
	@echo "  NDSTOOL $@"
	$(V)$(BLOCKSDS)/tools/ndstool/ndstool -c $@ \
		-7 $(ARM7ELF) -9 $(ELF)

$(ELF): $(OBJS)
	@echo "  LD      $@"
	$(V)$(LD) -o $@ $(OBJS) $(LDFLAGS)

$(DUMP): $(ELF)
	@echo "  OBJDUMP   $@"
	$(V)$(OBJDUMP) -h -C -S $< > $@

dump: $(DUMP)

clean:
	@echo "  CLEAN"
	$(V)$(RM) $(ROM) $(DUMP) build compile_commands.json

$(BUILDDIR)/%.s.o : %.s
	@echo "  AS      $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CC) $(ASFLAGS) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.c.o : %.c
	@echo "  CC      $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.cpp.o : %.cpp
	@echo "  CXX     $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

-include $(DEPS)
